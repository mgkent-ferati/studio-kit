{% extends 'base.html.twig' %}

{% block title %}{{ mappe.name }} – studio-kit{% endblock %}

{% block body %}
    <h1>{{ mappe.name }}</h1>
    {% if mappe.beschreibung %}<p>{{ mappe.beschreibung }}</p>{% endif %}

    <section class="ergebnis">
        <h2>Ergebnis</h2>
        {% if ergebnisFassungen is not empty %}
            {% set aktuell = ergebnisFassungen|first %}
            <p>Fassung {{ aktuell.nummer }} · {{ aktuell.herkunft.label }} ·
                <a href="{{ path('fassung_download', {id: aktuell.id}) }}">Herunterladen</a> ·
                <a href="{{ path('datei_detail', {id: mappe.ergebnis.id}) }}">alle Fassungen</a></p>
            {% include '_vorschau.html.twig' with {fassung: aktuell} %}
            {% if ergebnisFassungen|length > 1 %}
                <details class="aeltere-fassungen">
                    <summary>Ältere Fassungen ({{ ergebnisFassungen|length - 1 }})</summary>
                    <table>
                        {% for fassung in ergebnisFassungen|slice(1) %}
                            <tr class="aeltere-fassung">
                                <td>Fassung {{ fassung.nummer }}</td>
                                <td>{{ fassung.originalname }}</td>
                                <td>{{ fassung.herkunft.label }}</td>
                                <td>{{ fassung.erstelltAm|date('d.m.Y H:i') }}</td>
                                <td><a href="{{ path('fassung_download', {id: fassung.id}) }}">Herunterladen</a></td>
                            </tr>
                        {% endfor %}
                    </table>
                </details>
            {% endif %}
        {% else %}
            <p>Noch kein Ergebnis.</p>
        {% endif %}
        <form method="post" action="{{ path('mappe_ergebnis_hochladen', {id: mappe.id}) }}" enctype="multipart/form-data" class="zeile">
            <input type="hidden" name="_token" value="{{ csrf_token('ergebnis') }}">
            <input type="file" name="datei">
            <label><input type="checkbox" name="trotzdem" value="1"> trotzdem anlegen</label>
            <button type="submit">{{ mappe.ergebnis ? 'Neue Fassung hochladen' : 'Ergebnis hochladen' }}</button>
        </form>
        {% block musik %}
            <h3>Musik unterlegen</h3>
            {% if mappe.ergebnis is null or mappe.ergebnis.typ.value != 'video' %}
                <p>Zum Musikunterlegen braucht die Mappe ein Video als Ergebnis.</p>
            {% elseif audioBestandteile is empty %}
                <p>Füge zuerst eine Audio-Datei als Bestandteil hinzu.</p>
            {% else %}
                <form method="post" action="{{ path('mappe_musik_unterlegen', {id: mappe.id}) }}" class="zeile">
                    <input type="hidden" name="_token" value="{{ csrf_token('musik') }}">
                    <select name="audio_id">
                        {% for audio in audioBestandteile %}
                            <option value="{{ audio.id }}">{{ audio.name }}</option>
                        {% endfor %}
                    </select>
                    <label>Lautstärke <input type="number" name="lautstaerke" value="1" min="0" max="2" step="0.05"></label>
                    <label>Start im Song (s) <input type="number" name="start" value="0" min="0" step="0.1"></label>
                    <label><input type="checkbox" name="original" value="1" checked> Originalton behalten</label>
                    <button type="submit">Musik unterlegen</button>
                </form>
            {% endif %}
        {% endblock %}
    </section>

    <h2>Bestandteile</h2>
    <p><a href="{{ path('mappe_zip', {id: mappe.id}) }}">Alle Bestandteile als ZIP</a></p>
    <table>
        {% for bestandteil in mappe.bestandteile %}
            {% set datei = bestandteil.datei %}
            <tr class="bestandteil">
                <td><a href="{{ path('datei_detail', {id: datei.id}) }}">{{ datei.name }}</a></td>
                <td>{{ datei.typ.label }} · Fassung {{ datei.aktuelleFassung.nummer }}</td>
                <td>
                    <form method="post" action="{{ path('mappe_bestandteil_verschieben', {id: mappe.id, dateiId: datei.id}) }}" style="display: inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('bestandteil-' ~ datei.id) }}">
                        <input type="hidden" name="richtung" value="hoch">
                        <button type="submit" title="nach oben">↑</button>
                    </form>
                    <form method="post" action="{{ path('mappe_bestandteil_verschieben', {id: mappe.id, dateiId: datei.id}) }}" style="display: inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('bestandteil-' ~ datei.id) }}">
                        <input type="hidden" name="richtung" value="runter">
                        <button type="submit" title="nach unten">↓</button>
                    </form>
                    <form method="post" action="{{ path('mappe_bestandteil_entfernen', {id: mappe.id, dateiId: datei.id}) }}" style="display: inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('bestandteil-' ~ datei.id) }}">
                        <button type="submit">Entfernen</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td>Noch keine Bestandteile.</td></tr>
        {% endfor %}
    </table>

    <form method="post" action="{{ path('mappe_bestandteil_hinzufuegen', {id: mappe.id}) }}" class="zeile">
        <input type="hidden" name="_token" value="{{ csrf_token('bestandteil') }}">
        <select name="datei_id">
            {% for datei in alleDateien %}
                <option value="{{ datei.id }}">{{ datei.name }} ({{ datei.typ.label }})</option>
            {% endfor %}
        </select>
        <button type="submit">Hinzufügen</button>
    </form>
    <form method="post" action="{{ path('mappe_bestandteil_hinzufuegen', {id: mappe.id}) }}" enctype="multipart/form-data" class="zeile">
        <input type="hidden" name="_token" value="{{ csrf_token('bestandteil') }}">
        <input type="file" name="datei">
        <label><input type="checkbox" name="trotzdem" value="1"> trotzdem anlegen</label>
        <button type="submit">Hochladen und hinzufügen</button>
    </form>

    <h2>Bearbeiten</h2>
    <form method="post" action="{{ path('mappe_bearbeiten', {id: mappe.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('mappe-bearbeiten') }}">
        <p><input name="name" value="{{ mappe.name }}" required maxlength="255" size="40"></p>
        <p><textarea name="beschreibung" rows="3" cols="60" placeholder="Beschreibung">{{ mappe.beschreibung }}</textarea></p>
        <p><input name="schlagwoerter" value="{{ mappe.schlagwoerter|map(s => s.name)|join(', ') }}" placeholder="Schlagwörter, kommagetrennt" size="40">
            <label><input type="checkbox" name="vorlage" value="1" {{ mappe.vorlage ? 'checked' }}> Vorlage</label></p>
        <button type="submit">Speichern</button>
    </form>

    <form method="post" action="{{ path('mappe_loeschen', {id: mappe.id}) }}" style="margin-top: 2rem">
        <input type="hidden" name="_token" value="{{ csrf_token('mappe-loeschen') }}">
        <button type="submit" class="gefahr">Mappe löschen</button>
        <small>Die Dateien bleiben in der Bibliothek.</small>
    </form>
{% endblock %}

{% block scripts %}
    {% if ergebnisFassungen is not empty and mappe.ergebnis.typ.value == 'rive' %}
        {% include '_rive_script.html.twig' %}
    {% endif %}
{% endblock %}
