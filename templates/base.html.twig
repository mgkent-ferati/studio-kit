<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}studio-kit{% endblock %}</title>
    <style>
        :root { --rand: #e3dcd5; --text: #2b2420; --akzent: #b5726b; --fehler: #a33; --erfolg: #2f7a4a; }
        * { box-sizing: border-box; }
        body { margin: 0; font: 15px/1.5 system-ui, sans-serif; color: var(--text); background: #fbf8f5; }
        nav { display: flex; gap: 1.5rem; padding: .8rem 1.5rem; border-bottom: 1px solid var(--rand); background: #fff; }
        nav a { color: var(--text); text-decoration: none; font-weight: 600; }
        main { padding: 1.5rem; max-width: 1200px; margin: 0 auto; }
        a { color: var(--akzent); }
        .flash { padding: .6rem .9rem; border-radius: 6px; margin: 0 0 .6rem; }
        .flash-erfolg { background: #e6f3ea; color: var(--erfolg); }
        .flash-fehler { background: #f8e5e5; color: var(--fehler); }
        .raster { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; }
        .kachel { background: #fff; border: 1px solid var(--rand); border-radius: 8px; overflow: hidden; color: inherit; text-decoration: none; }
        .kachel .bild { aspect-ratio: 9 / 16; max-height: 220px; width: 100%; background: #f1ece7; display: flex; align-items: center; justify-content: center; font-size: 2rem; }
        .kachel .bild img, .kachel .bild video { width: 100%; height: 100%; object-fit: cover; }
        .kachel .info { padding: .5rem .7rem; font-size: .85rem; }
        .marke { display: inline-block; padding: 0 .4rem; border-radius: 4px; background: #f1e3df; font-size: .75rem; margin-right: .2rem; }
        .ablage { display: block; border: 2px dashed var(--rand); border-radius: 8px; padding: 1.2rem; text-align: center; cursor: pointer; background: #fff; }
        form.zeile { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin: 0 0 1rem; }
        input, select, textarea, button { font: inherit; padding: .35rem .5rem; }
        button { cursor: pointer; }
        button.gefahr { color: var(--fehler); }
        table { border-collapse: collapse; width: 100%; }
        td, th { border-bottom: 1px solid var(--rand); padding: .4rem; text-align: left; }
        .vorschau video, .vorschau img, .vorschau canvas { max-width: 100%; max-height: 70vh; }
        .fehlt { color: var(--fehler); font-weight: 600; }
    </style>
</head>
<body>
<nav>
    <a href="{{ path('bibliothek_index') }}">Bibliothek</a>
    {% block nav_extra %}{% endblock %}
</nav>
<main>
    {% for typ, meldungen in app.flashes %}
        {% for meldung in meldungen %}<p class="flash flash-{{ typ }}">{{ meldung }}</p>{% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
{% block scripts %}{% endblock %}
</body>
</html>
